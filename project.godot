[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[layer_names]

2d_physics/layer_1="Mundo y jugador"
2d_physics/layer_2="Plataformas escalables"
2d_physics/layer_3="Enemigos"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/multi_bounce_occlusion/enabled=true
